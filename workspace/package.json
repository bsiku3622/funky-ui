{
  "name": "funky-ui-monorepo",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @funky-ui/app dev",
    "build": "pnpm --filter @studio-baeks/funky-ui build && pnpm --filter @funky-ui/app build",
    "typecheck": "pnpm -r typecheck",
    "check": "pnpm typecheck && pnpm build"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "typescript": "^5.6.0"
  },
  "packageManager": "pnpm@11.0.9",
  "engines": {
    "node": ">=20",
    "pnpm": ">=11"
  }
}
