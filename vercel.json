{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "cd workspace && npx --yes pnpm@11.0.9 install --frozen-lockfile",
  "buildCommand": "cd workspace && npx --yes pnpm@11.0.9 --filter @funky-ui/app build",
  "outputDirectory": "workspace/app/dist",
  "rewrites": [
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
