{
  "name": "@studio-baeks/funky-ui",
  "version": "0.3.0",
  "type": "module",
  "description": "Brutalist / neo-retro React design system (cream + black border + hard shadow).",
  "author": "Studio Baeks",
  "license": "MIT",
  "keywords": [
    "react",
    "design-system",
    "ui",
    "components",
    "neo-brutalism",
    "brutalist",
    "neon",
    "funky-ui"
  ],
  "sideEffects": [
    "*.css"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./markdown": {
      "types": "./dist/markdown.d.ts",
      "import": "./dist/markdown.js",
      "require": "./dist/markdown.cjs"
    },
    "./styles.css": "./dist/styles.css",
    "./markdown.css": "./dist/markdown.css",
    "./tokens.css": "./dist/tokens.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "gen:tokens": "node scripts/gen-tokens.ts",
    "prebuild": "node scripts/gen-tokens.ts",
    "build": "tsup",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18",
    "react-markdown": ">=9",
    "remark-gfm": ">=4",
    "remark-math": ">=6",
    "rehype-slug": ">=6",
    "rehype-katex": ">=7",
    "katex": ">=0.16",
    "github-slugger": ">=2"
  },
  "peerDependenciesMeta": {
    "react-markdown": {
      "optional": true
    },
    "remark-gfm": {
      "optional": true
    },
    "remark-math": {
      "optional": true
    },
    "rehype-slug": {
      "optional": true
    },
    "rehype-katex": {
      "optional": true
    },
    "katex": {
      "optional": true
    },
    "github-slugger": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "@types/katex": "^0.16.7",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-markdown": "^9.0.1",
    "remark-gfm": "^4.0.0",
    "remark-math": "^6.0.0",
    "rehype-slug": "^6.0.0",
    "rehype-katex": "^7.0.1",
    "katex": "^0.16.11",
    "github-slugger": "^2.0.0",
    "tsup": "^8.3.5",
    "typescript": "^5.4.0"
  }
}
