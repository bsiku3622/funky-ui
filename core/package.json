{
  "name": "@studio-baeks/funky-ui",
  "version": "0.1.0",
  "type": "module",
  "description": "Brutalist / neo-retro React design system (cream + black border + hard shadow).",
  "author": "Studio Baeks",
  "license": "MIT",
  "keywords": [
    "react",
    "design-system",
    "ui",
    "components",
    "neo-brutalism",
    "brutalist",
    "neon",
    "funky-ui"
  ],
  "sideEffects": [
    "*.css"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./styles.css": "./dist/styles.css",
    "./tokens.css": "./dist/tokens.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "gen:tokens": "node scripts/gen-tokens.ts",
    "prebuild": "node scripts/gen-tokens.ts",
    "build": "tsup",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "tsup": "^8.3.5",
    "typescript": "^5.4.0"
  }
}
